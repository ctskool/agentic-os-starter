# Agentic OS — environment file
# Copy to ~/.claude/.env and fill in. Every script and the runner read from here.
# Nothing in this repo contains real keys — this file is the single place secrets live.

# REQUIRED — absolute path to your vault (the folder Obsidian opens).
# Windows example: C:/Users/you/the-vault   Mac example: /Users/you/the-vault
AGENTIC_OS_VAULT=

# Model the headless runner uses for background skill runs (keep cheap).
AGENTIC_OS_MODEL=sonnet

# --- Metrics sources (used by /metrics-pull; leave blank to skip a source) ---
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Your channel id (starts with UC...): https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=
# Public handles (no @) for follower scrapes
INSTAGRAM_HANDLE=
TIKTOK_HANDLE=

# --- Voice module (optional; local Kokoro TTS + faster-whisper STT) ---
# Voice for Kokoro TTS (bm_george = calm British male; see kokoro-onnx voices)
KOKORO_VOICE=bm_george
KOKORO_SPEED=1.0
# Whisper STT model (small.en default; tiny.en if CPU-only and slow)
WHISPER_MODEL=small.en
# Wake word: off = push-to-talk only (recommended; speaker bleed makes
# hands-free overlap replies). Set on to arm "hey jarvis".
WAKE_WORD=off
